rsource "Kconfig.defaults"

menu "Modules"

config BUTTON_DEBOUNCE_MS
	int "Button debounce time in ms"
	default 50

config BUTTON_SCAN
	bool "Build the unknown-button pin scanner"
	default n
	help
	  Adds the btnscan shell command, which configures every GPIO not
	  claimed by a peripheral as an input and reports any pin that
	  changes level. Used to find which pin a push button is wired to
	  when the devicetree button nodes do not match the hardware.

if BUTTON_SCAN

config BUTTON_SCAN_AT_BOOT
	bool "Run a pin scan continuously from boot"
	default n
	help
	  Starts a scan shortly after boot and loops until reset, so the
	  button can simply be held down without typing a command first.
	  Results are also left in button_scan_last for SWD readout.

config BUTTON_SCAN_BOOT_DELAY_MS
	int "Delay before the boot scan starts"
	depends on BUTTON_SCAN_AT_BOOT
	default 3000
	help
	  Gives the rest of init time to claim its peripheral pins before
	  the scanner decides which pins are free.

config BUTTON_SCAN_DURATION_MS
	int "Scan duration for the btnscan shell command"
	default 20000

config BUTTON_SCAN_PERIOD_MS
	int "Delay between scan cycles"
	default 250

config BUTTON_SCAN_HEARTBEAT_MS
	int "Reprint the full pin state this often, even if unchanged"
	default 5000
	help
	  Without this a scan that finds nothing is indistinguishable from
	  a scan thread that has died.

config BUTTON_SCAN_FOCUS
	bool "Also probe one known pin under every pull setting"
	default n
	help
	  Reads a single pin with no pull, a pull-up and a pull-down on each
	  heartbeat. Distinguishes a pin held to ground from one that simply
	  floats, and from one that is not acting as a GPIO at all.

# Not gated on BUTTON_SCAN_FOCUS: focus_probe() is compiled whenever the
# scanner is, so these have to resolve even when the probe is disabled.
config BUTTON_SCAN_FOCUS_PORT
	int "Focus probe port (0 = P0, 1 = P1)"
	default 0

config BUTTON_SCAN_FOCUS_PIN
	int "Focus probe pin"
	default 0

endif # BUTTON_SCAN

config AUDIO_SYNC_TIMER_USES_RTC
	bool
	default y
	select NRFX_RTC0

#----------------------------------------------------------------------------#
menuconfig NRF5340_AUDIO_POWER_MEASUREMENT
	bool "Power measurement"
	help
	  Include the power measurement driver for the nRF5340 Audio DK

if NRF5340_AUDIO_POWER_MEASUREMENT

config POWER_MEAS_INTERVAL_MS
	int "Power measurement interval in milliseconds"
	default 8500
	help
	  Power measurement runs continuously, this option just establishes the
	  results polling period. Note that this value needs to be >= the configured
	  sampling interval on the current sensor. When below, repeated measurements
	  will be observed.

config POWER_MEAS_START_ON_BOOT
	bool "Start power measurements for all rails on boot"
	help
	  This option will automatically start and periodically print
	  the voltage, current consumption, and power usage for the
	  following rails: VBAT, VDD1_CODEC, VDD2_CODEC, and VDD2_NRF

endif # NRF5340_AUDIO_POWER_MEASUREMENT

#----------------------------------------------------------------------------#
menu "I2S"

config I2S_LRCK_FREQ_HZ
	int
	default AUDIO_SAMPLE_RATE_HZ
	help
	 The sample rate of I2S. For now this is tied directly to
	 AUDIO_SAMPLE_RATE_HZ
	 Note that this setting is only valid in I2S master mode.

config I2S_CH_NUM
	int
	default 2
	help
	 The I2S driver itself supports both mono and stereo.
	 Parts of the implementation are configured for only stereo.

endmenu # I2S

